{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NevIxplore",
  "version": "0.1.0",
  "identifier": "dev.nevixplore.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NevIxplore",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NevIxplore contributors",
    "copyright": "Copyright (c) NeviXplore contributors",
    "category": "Utility",
    "shortDescription": "A fast, beautiful Windows file manager",
    "longDescription": "NevIxplore opens any directory instantly, finds any file by name as you type, shows the metadata you need, and never shows an ad.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
